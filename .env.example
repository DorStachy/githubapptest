NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codefense
DB_HOST=localhost
DB_PORT=5432
DB_NAME=codefense
DB_USER=postgres
DB_PASSWORD=

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d
SESSION_SECRET=

# OAuth (GitHub App)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/oauth/callback

# S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=codefense-reports-dev

# SQS
SQS_QUEUE_URL=
SQS_REGION=us-east-1

# Email
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@codefense.dev

# Feature Flags
ENABLE_SANDBOX_ANALYSIS=true
ENABLE_EMAIL_NOTIFICATIONS=true
MAX_UPLOAD_SIZE_MB=50
